{
  "name": "veliza",
  "version": "1.0.0",
  "description": "Catálogo web de Véliza",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:unit && npm run test:int",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run tests/int",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "seed:pages": "node scripts/extract-catalog-pages.mjs",
    "seed:preview": "tsx scripts/preview-crops.ts",
    "test:e2e": "playwright test",
    "e2e:fixtures": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/e2e-fixtures.ts",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@tailwindcss/postcss": "^4.3.3",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "^16.3.8",
    "payload": "3.90.2",
    "postcss": "^8.5.28",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.3.8",
    "pdf-to-img": "^7.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.22.4",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "overrides": {
    "payload": {
      "undici": "7.30.0"
    }
  }
}
